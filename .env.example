# Copy to .env and adjust as needed.

# true = simulate ANPR/live feed data, no GPU/CCTV/paid APIs required
DEMO_MODE=true

# SQLite by default - zero external services required.
# Swap for Postgres later if you want, e.g.:
# DATABASE_URL=postgresql+psycopg2://user:pass@localhost:5432/cityvision
DATABASE_URL=sqlite:///./cityvision.db

SECRET_KEY=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=480

YOLO_PLATE_MODEL_PATH=models/yolov8_plate.pt
PADDLEOCR_LANG=en

SIMULATOR_TICK_SECONDS=6
SIMULATOR_ENABLED=true
